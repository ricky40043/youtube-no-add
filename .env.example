# Core services
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/youtube_alt
REDIS_URL=redis://redis:6379

# Authentication (optional; a persistent backend/.jwt_secret is generated when empty)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:20800

# SMTP is required for recovery email and forgot-password delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
